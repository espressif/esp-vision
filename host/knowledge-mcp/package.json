{
  "name": "@esp-vision/knowledge-mcp",
  "version": "0.1.1",
  "description": "Public stdio and Streamable HTTP Knowledge MCP runtime for ESP-VISION.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/service.js",
    "./service": "./dist/service.js"
  },
  "bin": {
    "esp-vision-knowledge-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "data/mcp-pack.json",
    "data/provenance.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run check:package",
    "start": "node dist/server.js",
    "start:stdio": "node dist/cli.js --transport stdio",
    "test": "node --test test/*.test.mjs",
    "stats:report": "node dist/stats-cli.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "express": "^5.1.0",
    "minisearch": "^7.1.0",
    "supports-color": "^11.0.0",
    "typescript": "^5.5.0",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espressif/esp-vision.git",
    "directory": "host/knowledge-mcp"
  }
}
