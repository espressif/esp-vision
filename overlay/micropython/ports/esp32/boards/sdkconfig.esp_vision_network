# EV-MUX TCP binds the STA address; do not advertise it on AP/Ethernet netifs.
CONFIG_MDNS_PREDEF_NETIF_STA=y
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
CONFIG_MDNS_MAX_INTERFACES=1

# Reserve DHCP option space for a full 63-byte hostname plus other options.
CONFIG_LWIP_DHCP_OPTIONS_LEN=255

# Reset-only TCP close enables positive linger on its detached socket; all
# ordinary sockets retain lwIP's disabled-by-default linger setting.
CONFIG_LWIP_SO_LINGER=y
