# Build output
/build/
/dist/
/artifacts/

# esp-launchpad packing output (merged bins + config.toml from
# tools/ci/launchpad/generate_launchpad.py; produced in CI / dry-run)
/binaries/

# Documentation build output
/docs/_build/

# Auto-generated API reference fragments (produced from stubs/*.pyi at build time)
docs/**/_generated/

# ESP-IDF generated
sdkconfig
sdkconfig.old
sdkconfig.ci
managed_components/
dependencies.lock

# Compiled artifacts
*.o
*.a
*.so
*.elf
*.bin
*.uf2
*.map

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# VSCode extension
vscode-extension/
/esp-vision-ide

# Patches / staging
*.rej
*.orig

# Editors / IDE
.vscode/
.specs/
specs/
.codex/
.claude/
.cursor/
.esp-vision/
.worktrees/
.idea/
*.swp
*.swo
.cache/
compile_commands.json

# Local agent state and plans (public plugin manifests are product source)
.agents/
!host/esp-vision-plugin/.agents/
host/esp-vision-plugin/.agents/*
!host/esp-vision-plugin/.agents/plugins/
host/esp-vision-plugin/.agents/plugins/*
!host/esp-vision-plugin/.agents/plugins/marketplace.json
/plans/
/scratch/
/investigations/
/handoffs/
.mcp.json
!host/esp-vision-plugin/.mcp.json

# Private environment and credential files; only sanitized templates are shared
.env
.env.*
!.env.example
!.env.template
.npmrc
.pypirc
.netrc

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
ae_upload_dl
esp-dl
esp-iot-solution

# Host SDK dependencies and local package output
host/**/node_modules/
host/**/*.tgz

# Generated standalone CLI bundle and dependency notices
host/device-cli/dist/
host/device-cli/licenses/

# Generated plugin CLI payload
host/esp-vision-plugin/cli/
# Knowledge MCP build artifacts
host/knowledge-mcp/dist/
host/knowledge-mcp/mcp-pack.json

# Generated Knowledge npm assets
host/knowledge-mcp/data/mcp-pack.json
host/knowledge-mcp/data/provenance.json
