+bool dcd_edpt_quiesce_async(uint8_t rhport, uint8_t ep_addr,
+                            dcd_edpt_quiesce_cb_t callback, void *user_data) {
+  const uint8_t epnum = tu_edpt_number(ep_addr);
+  if (!callback || epnum == 0 || epnum >= dwc2_ep_count(DWC2_REG(rhport)) ||
+      tu_edpt_dir(ep_addr) != TUSB_DIR_IN) {
+    return false;
+  }
+
+  dwc2_regs_t *dwc2 = DWC2_REG(rhport);
+  dwc2_dep_t *epin = &dwc2->epin[epnum];
+  ep_quiesce_t *state = &ep_quiesce[epnum];
+  bool accepted = false;
+
+  usbd_spin_lock(false);
+  if (!state->active && XFER_CTL_BASE(epnum, TUSB_DIR_IN)->max_size != 0) {
+    uint32_t cookie = state->cookie + 1;
+    if (cookie == 0) cookie = 1;
+    state->cookie = cookie;
+    state->callback = callback;
+    state->user_data = user_data;
+    state->active = true;
+    state->marker_queued = false;
+    state->quiesced = false;
+    state->phase = (epin->diepctl & DIEPCTL_EPENA) ? EP_QUIESCE_WAIT_NAK : EP_QUIESCE_START_FIFO_FLUSH;
+
+    // Stop both normal IN endpoint handling and incomplete-ISO retries before
+    // requesting the hardware NAK/disable sequence.
+    dwc2->daintmsk &= ~TU_BIT(epnum + DAINTMSK_IEPM_Pos);
+    dwc2->diepempmsk &= ~TU_BIT(epnum);
+    epin->diepctl |= DIEPCTL_SNAK;
+    accepted = true;
+  }
+  usbd_spin_unlock(false);
+  return accepted;
+}
+
+bool dcd_edpt_quiesce_task(uint8_t rhport) {
+  dwc2_regs_t *dwc2 = DWC2_REG(rhport);
+  bool pending = false;
+
+  for (uint8_t epnum = 1; epnum < dwc2_ep_count(dwc2); ++epnum) {
+    ep_quiesce_t *state = &ep_quiesce[epnum];
+    bool queue_marker = false;
+    uint32_t marker_cookie = 0;
+
+    usbd_spin_lock(false);
+    if (state->active) {
+      pending = true;
+      if (state->isr_inflight != 0) {
+        usbd_spin_unlock(false);
+        continue;
+      }
+      dwc2_dep_t *epin = &dwc2->epin[epnum];
+      uint32_t epctl = epin->diepctl;
+      uint32_t epint = epin->diepint;
+
+      switch ((ep_quiesce_phase_t)state->phase) {
+        case EP_QUIESCE_WAIT_NAK:
+          if (!(epctl & DIEPCTL_EPENA)) {
+            state->phase = EP_QUIESCE_START_FIFO_FLUSH;
+          } else if (epint & DIEPINT_INEPNE_Msk) {
+            // The SNAK request is effective; request endpoint disable, then
+            // poll EPENA/EPDISD without blocking this task or an ISR.
+            epin->diepctl |= DIEPCTL_EPDIS;
+            state->phase = EP_QUIESCE_WAIT_DISABLE;
+          }
+          break;
+
+        case EP_QUIESCE_WAIT_DISABLE:
+          if (!(epctl & DIEPCTL_EPENA) && (epint & DIEPINT_EPDISD_Msk)) {
+            state->phase = EP_QUIESCE_START_FIFO_FLUSH;
+          }
+          break;
+
+        case EP_QUIESCE_START_FIFO_FLUSH:
+          if (!(epctl & DIEPCTL_EPENA) && !(dwc2->grstctl & GRSTCTL_TXFFLSH_Msk)) {
+            // This is the DWC2 per-endpoint TX FIFO flush used by the normal
+            // disable path, issued once and polled on later task iterations.
+            dwc2->grstctl = GRSTCTL_TXFFLSH | (epnum << GRSTCTL_TXFNUM_Pos);
+            state->phase = EP_QUIESCE_WAIT_FIFO_FLUSH;
+          }
+          break;
+
+        case EP_QUIESCE_WAIT_FIFO_FLUSH:
+          if (!(dwc2->grstctl & GRSTCTL_TXFFLSH_Msk)) {
+            state->phase = EP_QUIESCE_CLEAR_STATUS;
+          }
+          break;
+
+        case EP_QUIESCE_CLEAR_STATUS: {
+          if (epctl & DIEPCTL_EPENA) {
+            state->phase = EP_QUIESCE_WAIT_DISABLE;
+            break;
+          }
+          // DIEPINT is write-one-to-clear. Follow the DCD's existing ISR
+          // treatment: write the observed value, then read back and verify
+          // callback-capable flags are gone before emitting a marker.
+          if (epint) epin->diepint = epint;
+          uint32_t const verify = epin->diepint;
+          uint32_t const callback_flags = DIEPINT_XFRC_Msk | DIEPINT_EPDISD_Msk |
+                                          DIEPINT_AHBERR_Msk | DIEPINT_TOC_Msk |
+                                          DIEPINT_INEPNE_Msk;
+          if (verify & callback_flags) {
+            state->phase = EP_QUIESCE_CLEAR_STATUS;
+          } else {
+            state->phase = EP_QUIESCE_READY;
+          }
+          break;
+        }
+
+        case EP_QUIESCE_READY:
+          if (!state->marker_queued) {
+            state->marker_queued = true;
+            marker_cookie = state->cookie;
+            queue_marker = true;
+          }
+          break;
+
+        case EP_QUIESCE_IDLE:
+        default:
+          // An impossible state remains masked and fails closed.
+          break;
+      }
+    }
+    usbd_spin_unlock(false);
+
+    if (queue_marker && !usbd_event_endpoint_quiesced(rhport, tu_edpt_addr(epnum, TUSB_DIR_IN), marker_cookie)) {
+      // Queue saturation must not release the class source. Retry after the
+      // task drains older events; the endpoint remains interrupt-masked.
+      usbd_spin_lock(false);
+      if (state->active && state->cookie == marker_cookie) {
+        state->marker_queued = false;
+      }
+      usbd_spin_unlock(false);
+    }
+  }
+
+  return pending;
+}
+
+void dcd_edpt_quiesce_complete(uint8_t rhport, uint8_t ep_addr, uint32_t cookie) {
+  const uint8_t epnum = tu_edpt_number(ep_addr);
+  if (epnum == 0 || epnum >= DWC2_EP_MAX || tu_edpt_dir(ep_addr) != TUSB_DIR_IN) return;
+
+  ep_quiesce_t *state = &ep_quiesce[epnum];
+  dcd_edpt_quiesce_cb_t callback = NULL;
+  void *user_data = NULL;
+
+  usbd_spin_lock(false);
+  if (state->active && state->marker_queued && state->cookie == cookie) {
+    state->active = false;
+    state->marker_queued = false;
+    state->phase = EP_QUIESCE_IDLE;
+    state->quiesced = true;
+    callback = state->callback;
+    user_data = state->user_data;
+    state->callback = NULL;
+    state->user_data = NULL;
+
+    xfer_ctl_t *xfer = XFER_CTL_BASE(epnum, TUSB_DIR_IN);
+    xfer->buffer = NULL;
+    xfer->ff = NULL;
+    xfer->total_len = 0;
+    xfer->iso_retry = 0;
+  }
+  usbd_spin_unlock(false);
+
+  if (callback) callback(rhport, ep_addr, user_data);
+}
