+static void _retire_frame(videod_streaming_interface_t *stm, bool cancelled) {
+  if (!stm->buffer) return;
+
+  uint8_t const tagged = stm->frame_tagged;
+  uint32_t const generation = stm->frame_generation;
+  uint32_t const transfer_id = stm->frame_transfer_id;
+  stm->buffer = NULL;
+  stm->bufsize = 0;
+  stm->offset = 0;
+  stm->frame_tagged = 0;
+  stm->frame_generation = 0;
+  stm->frame_transfer_id = 0;
+  stm->queued_size = 0;
+  stm->failed = false;
+
+  if (cancelled) {
+    if (tagged) {
+      tud_video_frame_xfer_cancelled_cb(stm->index_vc, stm->index_vs, generation, transfer_id);
+    } else if (tud_video_frame_xfer_failed_cb) {
+      tud_video_frame_xfer_failed_cb(stm->index_vc, stm->index_vs);
+    }
+  }
+}
+
+static void esp_vision_video_retire(videod_streaming_interface_t *stm, bool failed) {
+  uint8_t const tagged = stm->frame_tagged;
+  uint32_t const generation = stm->frame_generation;
+  uint32_t const transfer_id = stm->frame_transfer_id;
+  _retire_frame(stm, failed);
+  if (failed) return;
+  if (tagged) {
+    tud_video_frame_xfer_complete_tagged_cb(stm->index_vc, stm->index_vs, generation, transfer_id);
+  } else {
+    tud_video_frame_xfer_complete_cb(stm->index_vc, stm->index_vs);
+  }
+}
+
+static void _vs_quiesce_complete(uint8_t rhport, uint8_t ep_addr, void *user_data) {
+  (void)ep_addr;
+  videod_streaming_interface_t *stm = (videod_streaming_interface_t *)user_data;
+  if (!stm || !stm->cancel_pending) return;
+
+  uint8_t const pending_alt = stm->pending_alt;
+  _retire_frame(stm, true);
+  stm->cancel_pending = 0;
+  stm->pending_alt = 0;
+  stm->stream_open = 0;
+
+  // The DCD marker is ordered after all older endpoint events. The source
+  // pointer is now clear, so reopening cannot expose the old frame to a late
+  // completion.
+  (void)_open_vs_itf_now(rhport, stm, pending_alt);
+}
+
+static bool _request_vs_itf(uint8_t rhport, videod_streaming_interface_t *stm, uint_fast8_t altnum) {
+  uint8_t const *desc = _videod_itf[stm->index_vc].beg;
+  uint8_t const *beg = desc + stm->desc.beg;
+  uint8_t const *end = desc + stm->desc.end;
+  TU_VERIFY(_find_desc_itf(beg, end, _desc_itfnum(beg), altnum) < end, false);
+
+  if (stm->cancel_pending) {
+    stm->pending_alt = (uint8_t)altnum;
+    return true;
+  }
+
+  if (stm->buffer) {
+    uint_fast16_t const ep_ofs = stm->desc.ep[0];
+    TU_VERIFY(ep_ofs, false);
+    uint8_t const ep_addr = _desc_ep_addr(desc + ep_ofs);
+    if (!dcd_edpt_quiesce_async(rhport, ep_addr, _vs_quiesce_complete, stm)) {
+      return false;
+    }
+    stm->pending_alt = (uint8_t)altnum;
+    stm->cancel_pending = 1;
+    _stream_closed(stm, false);
+    return true;
+  }
+
+  _stream_closed(stm, false);
+  return _open_vs_itf_now(rhport, stm, altnum);
+}
